  if(captured>0){score+=captured*12;analysis.reasons.push(t('capture')+' '+captured+' '+t('stones_word'));}
  board[r][c]=0;let wasAtari=false,saved=0;
  for(const[dr,dc]of DIRS){const nr=r+dr,nc=c+dc;if(inBounds(nr,nc)&&board[nr][nc]===color){const g=getGroup(nr,nc);if(g.liberties===1){wasAtari=true;saved=Math.max(saved,g.stones.length);}}}
  board[r][c]=color;
  if(wasAtari){score+=saved*8;analysis.reasons.push(t('save_group')+' ('+saved+')');}
  let threatened=0;
  for(const[dr,dc]of DIRS){const nr=r+dr,nc=c+dc;if(inBounds(nr,nc)&&board[nr][nc]===op){const g=getGroup(nr,nc);if(g.liberties===1)threatened+=g.stones.length;}}
  if(threatened>0){score+=threatened*6;analysis.reasons.push(t('atari_on')+' '+threatened);}
  const myTB=color===1?terrBefore.black:terrBefore.white,myTA=color===1?terrAfter.black:terrAfter.white;
  const opTB=color===1?terrBefore.white:terrBefore.black,opTA=color===1?terrAfter.white:terrAfter.black;
  const terrGain=(myTA-myTB)+(opTB-opTA);analysis.terrGain=terrGain;
  if(terrGain>3){score+=terrGain*2;analysis.reasons.push(t('terr_gain')+' +'+Math.round(terrGain));}
  else if(terrGain<-2){score-=Math.abs(terrGain);analysis.reasons.push(t('terr_loss'));}
  if(moveNum<10){const stars=getStarPoints().map(([r,c])=>r+','+c);if(stars.includes(r+','+c)){score+=8;analysis.reasons.push(t('hoshi'));}if(distEdge>=2&&distEdge<=4)score+=5;if(distEdge===0){score-=10;analysis.reasons.push(t('first_line'));}}
  let ownAdj=0,emptyAdj=0;
  for(const[dr,dc]of DIRS){const nr=r+dr,nc=c+dc;if(inBounds(nr,nc)){if(board[nr][nc]===color)ownAdj++;else if(board[nr][nc]===0)emptyAdj++;}}
  if(ownAdj===1&&emptyAdj>=2){score+=3;analysis.reasons.push(t('extension'));}
  board[r][c]=0;const wasOwn=getAreaOwner(r,c);board[r][c]=color;
  if(wasOwn===color&&captured===0&&!wasAtari){score-=8;analysis.reasons.push(t('filling_own'));}
  if(influenceMap){const inf=influenceMap[r][c];const mySign=color===1?1:-1;if(Math.abs(inf)<0.5)score+=3;if(inf*mySign<-0.3){score+=2;analysis.reasons.push(t('invasion'));}}
  analysis.score=score;
  if(score>=20)analysis.rating='excellent';else if(score>=10)analysis.rating='good';else if(score>=2)analysis.rating='ok';else if(score>=-3)analysis.rating='dubious';else analysis.rating='bad';
  return analysis;
}
function generateContextComment(r,c,color,captured,analysis,isAI){
  const who=isAI?selectedAI.name:session.name;const moveNum=moveHistory.length;const comments=[];
  const phase=moveNum<8?'opening':(moveNum>boardSize*boardSize*0.45?'endgame':'midgame');
  if(captured>0){
    if(captured>=3)comments.push(who+' '+t('comment_big_capture')+' '+captured+' '+t('comment_stones_off'));
    else comments.push(who+' '+t('comment_captures')+' '+captured+'.');
  }
  for(const reason of analysis.reasons){
    if(reason.startsWith(t('save_group'))){comments.push(who+' '+t('comment_saves'));break;}
    if(reason.startsWith(t('atari_on'))){comments.push(who+' '+t('comment_atari'));break;}
  }
  if(comments.length===0){
    const distEdge=Math.min(r,c,boardSize-1-r,boardSize-1-c);
    if(phase==='opening'){
      if(distEdge>=2&&distEdge<=4){
        const corner=r<boardSize/2?(c<boardSize/2?t('corner_ul'):t('corner_ur')):(c<boardSize/2?t('corner_bl'):t('corner_br'));
        comments.push(who+' '+t('comment_corner')+' '+corner+' '+t('comment_corner_suf'));
      }else if(distEdge>4)comments.push(who+' '+t('comment_influence'));
      else comments.push(who+' '+t('comment_line')+' '+(distEdge+1)+t('comment_line_suf'));
    }else if(phase==='midgame'){
      if(analysis.terrGain>5)comments.push(who+' '+t('comment_terr_op')+' (+'+Math.round(analysis.terrGain)+').');
      else if(analysis.reasons.some(r=>r===t('invasion')))comments.push(who+' '+t('comment_invade'));
      else if(analysis.reasons.some(r=>r===t('extension')))comments.push(who+' '+t('comment_extend'));
      else comments.push(who+' '+t('comment_fortify'));
    }else comments.push(who+' '+t('comment_endgame')+(analysis.terrGain>0?' (+'+Math.round(analysis.terrGain)+' '+t('comment_pts')+')':'')+'.');
  }
  if(isAI&&Math.random()<0.4){
    const pKey='personality_'+selectedAI.style;const p=t(pKey);
    if(Array.isArray(p))comments.push('"'+p[Math.floor(Math.random()*p.length)]+'"');
  }
  const ratingLabels={excellent:t('excellent'),good:t('good'),ok:t('ok_move'),dubious:t('dubious'),bad:t('bad_move')};
  if(analysis.rating==='excellent'||analysis.rating==='bad')comments.push(ratingLabels[analysis.rating]);
  if(comments.length>0)addAIChat(who,comments.join(' '));
}
