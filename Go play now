function undoMove(){if(moveHistory.length<2)return;moveHistory.pop();moveHistory.pop();boardStates.pop();boardStates.pop();currentMoveIndex=moveHistory.length-1;board=JSON.parse(JSON.stringify(boardStates[boardStates.length-1]));computeInfluence();drawBoard();updateMoveList();updateEvaluation();updateAnalysisBar();addSystemMessage(t('sys_undo'));}
function resignGame(){if(!gameActive)return;playResignSound();endGame('loss',t('sys_resign'));}
function calculateFinalScore(){
  let bS=capturedBlack,wS=capturedWhite;const komi=parseFloat(document.getElementById('komi').value);
  for(let r=0;r<boardSize;r++)for(let c=0;c<boardSize;c++){if(board[r][c]===0){const o=getAreaOwner(r,c);if(o===1)bS++;else if(o===2)wS++;}}
  wS+=komi;const result=bS>wS?(playerColor==='black'?'win':'loss'):(playerColor==='white'?'win':'loss');
  endGame(result,'B: '+bS.toFixed(1)+' — W: '+wS.toFixed(1));
}
function endGame(result,detail){
  gameActive=false;if(timerInterval)clearInterval(timerInterval);if(gameElapsedInterval)clearInterval(gameElapsedInterval);
  const K=32,expected=1/(1+Math.pow(10,(selectedAI.elo-session.elo)/400)),actual=result==='win'?1:0;
  const eloDelta=Math.round(K*(actual-expected));session.elo=Math.max(50,session.elo+eloDelta);
  if(result==='win')session.wins++;else session.losses++;
  session.games.push({opponent:selectedAI.name,result,size:boardSize,moves:moveHistory.length,date:new Date().toLocaleDateString(),elo:session.elo});
  saveSession();updateProfileUI();
  playGameOverSound(result==='win');
  document.getElementById('gameOverTitle').textContent=result==='win'?t('win_text'):t('loss_text');
  document.getElementById('gameOverResult').textContent=result==='win'?t('you_won'):t('you_lost');
  document.getElementById('gameOverResult').style.color=result==='win'?'var(--good)':'var(--bad)';
  document.getElementById('gameOverDetails').textContent=detail;
  document.getElementById('gameOverRating').textContent=t('rating_text')+': '+session.elo+' ('+(eloDelta>=0?'+':'')+eloDelta+') — '+eloToRank(session.elo);
  document.getElementById('gameOverCommentary').innerHTML=generateGameCommentary(result);
  showModal('gameOverModal');addSystemMessage(t('sys_game_over')+' '+detail);
}
function generateGameCommentary(result){
  const pMoves=moveHistory.filter(m=>playerColor==='black'?m.color===1:m.color===2);
  const exc=pMoves.filter(m=>m.eval==='excellent').length,good=pMoves.filter(m=>m.eval==='good').length;
  const ok=pMoves.filter(m=>m.eval==='ok').length,dub=pMoves.filter(m=>m.eval==='dubious').length,bad=pMoves.filter(m=>m.eval==='bad').length;
  let h='<p><b>'+t('an_from')+' '+selectedAI.name+':</b></p>';
  h+='<p>'+t('an_total')+': '+moveHistory.length+'. '+t('an_yours')+': '+pMoves.length+'.</p>';
  h+='<p>★ '+t('an_excellent')+': <b style="color:var(--good)">'+exc+'</b> | + '+t('an_good')+': <b style="color:var(--accent)">'+good+'</b> | ~ '+t('an_normal')+': <b>'+ok+'</b> | ? '+t('an_dubious')+': <b style="color:var(--ok)">'+dub+'</b> | ✗ '+t('an_errors')+': <b style="color:var(--bad)">'+bad+'</b></p>';
  const capP=playerColor==='black'?capturedBlack:capturedWhite,capA=playerColor==='black'?capturedWhite:capturedBlack;
  h+='<p>'+t('an_captured')+': '+capP+' '+t('an_stones')+'. '+t('an_lost')+': '+capA+'.</p>';
  if(result==='win'){if(exc>good)h+='<p>'+t('an_great')+'</p>';else if(bad===0)h+='<p>'+t('an_stable')+'</p>';else h+='<p>'+t('an_win_but')+'</p>';}
  else{if(bad>3)h+='<p>'+t('an_errors_many')+'</p>';else if(dub>good)h+='<p>'+t('an_dubious_many')+'</p>';else h+='<p>'+t('an_good_try')+'</p>';}
  h+='<p style="color:var(--text4)"><i>'+t('an_play_more')+'</i></p>';return h;
}
