  let totalCap=0,capStones=[];
  for(const[dr,dc]of DIRS){const nr=r+dr,nc=c+dc;
    if(inBounds(nr,nc)&&board[nr][nc]===op){const g=getGroup(nr,nc);if(g.liberties===0){totalCap+=g.stones.length;capStones=capStones.concat(g.stones);removeGroup(g.stones);}}}
  if(totalCap===1&&capStones.length===1)koPoint=[capStones[0][0],capStones[0][1]];else koPoint=null;
  if(color===1)capturedBlack+=totalCap;else capturedWhite+=totalCap;
  if(currentMoveIndex<moveHistory.length-1){moveHistory=moveHistory.slice(0,currentMoveIndex+1);boardStates=boardStates.slice(0,currentMoveIndex+2);}
  const letters='ABCDEFGHJKLMNOPQRST';const moveLabel=letters[c]+(boardSize-r);
  const terrAfter=countTerritory();const ma=analyzeMoveQuality(r,c,color,totalCap,terrBefore,terrAfter,isAI);
  moveHistory.push({row:r,col:c,color,label:moveLabel,captured:totalCap,eval:ma.rating,analysis:ma});
