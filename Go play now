function computeInfluence(){
  const inf=Array.from({length:boardSize},()=>Array(boardSize).fill(0));
  const range=Math.min(6,boardSize-1);
  for(let r=0;r<boardSize;r++)for(let c=0;c<boardSize;c++){
    if(board[r][c]!==0){const sign=board[r][c]===1?1:-1;
      for(let dr=-range;dr<=range;dr++)for(let dc=-range;dc<=range;dc++){
        const nr=r+dr,nc=c+dc;if(!inBounds(nr,nc))continue;
        const dist=Math.abs(dr)+Math.abs(dc);if(dist>range)continue;
        let decay=Math.pow(0.6,dist);
        if(dist>0){const sr=dr===0?0:(dr>0?1:-1),sc=dc===0?0:(dc>0?1:-1);let pr=r+sr,pc=c+sc,bl=false;
          for(let s=0;s<dist-1;s++){if(inBounds(pr,pc)&&board[pr][pc]===opp(board[r][c])){bl=true;break;}pr+=sr;pc+=sc;}
          if(bl)decay*=0.1;}
        inf[nr][nc]+=sign*decay;
      }
    }
  }
  influenceMap=inf;return inf;
}
function getAreaOwner(r,c){
  if(board[r][c]!==0)return board[r][c];
  const vis=new Set();let bC=0,wC=0;const q=[[r,c]];vis.add(r*boardSize+c);
  while(q.length>0&&vis.size<boardSize*boardSize){
    const[cr,cc]=q.shift();
    for(const[dr,dc]of DIRS){const nr=cr+dr,nc=cc+dc;if(!inBounds(nr,nc))continue;
      const k=nr*boardSize+nc;if(vis.has(k))continue;
      if(board[nr][nc]===1){bC++;vis.add(k);}else if(board[nr][nc]===2){wC++;vis.add(k);}
      else{vis.add(k);q.push([nr,nc]);}
    }
  }
  if(bC>0&&wC===0)return 1;if(wC>0&&bC===0)return 2;return 0;
}
function countTerritory(){
  let bT=0,wT=0;
  for(let r=0;r<boardSize;r++)for(let c=0;c<boardSize;c++){
    if(board[r][c]===1)bT++;else if(board[r][c]===2)wT++;
    else{const o=getAreaOwner(r,c);if(o===1)bT++;else if(o===2)wT++;}
  }
  return{black:bT+capturedBlack,white:wT+capturedWhite};
}
function getGroup(r,c){
  const color=board[r][c];if(color===0)return{stones:[],liberties:0,libs:new Set()};
  const stones=[],libs=new Set(),vis=new Set(),q=[[r,c]];vis.add(r*boardSize+c);
  while(q.length>0){const[cr,cc]=q.shift();stones.push([cr,cc]);
    for(const[dr,dc]of DIRS){const nr=cr+dr,nc=cc+dc;if(!inBounds(nr,nc))continue;
      const k=nr*boardSize+nc;if(vis.has(k))continue;vis.add(k);
      if(board[nr][nc]===0)libs.add(k);else if(board[nr][nc]===color)q.push([nr,nc]);}
  }
  return{stones,liberties:libs.size,libs};
}
