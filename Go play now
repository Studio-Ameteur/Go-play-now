function passMove(isAI=false){
  if(!gameActive)return;passCount++;playPassSound();
  moveHistory.push({row:-1,col:-1,color:currentPlayer,label:lang==='ru'?'Пас':'Pass',captured:0,eval:'ok',analysis:{rating:'ok',reasons:[],score:0}});
  currentMoveIndex=moveHistory.length-1;boardStates.push(JSON.parse(JSON.stringify(board)));
  updateMoveList();addSystemMessage((isAI?selectedAI.name:session.name)+t('sys_pass_suf'));
  document.getElementById('moveCounter').textContent=t('move')+': '+moveHistory.length;
