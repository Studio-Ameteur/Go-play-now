function isValidMove(r,c,color){
  if(!inBounds(r,c)||board[r][c]!==0)return false;
  if(koPoint&&koPoint[0]===r&&koPoint[1]===c)return false;
  board[r][c]=color;const op=opp(color);let cap=false;
  for(const[dr,dc]of DIRS){const nr=r+dr,nc=c+dc;if(inBounds(nr,nc)&&board[nr][nc]===op&&getGroup(nr,nc).liberties===0)cap=true;}
  const sg=getGroup(r,c);if(sg.liberties===0&&!cap){board[r][c]=0;return false;}
  board[r][c]=0;return true;
}
function placeStone(r,c,color,isAI=false){
