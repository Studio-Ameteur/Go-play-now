sp.classList.add('fade-out');
setTimeout(function(){sp.style.display='none';afterSplash();},600);
}
}

function afterSplash(){
if(!licensed&&!localStorage.getItem('_0xgl')){
showLicensePrompt();
}else{
proceedAfterLicense();
}
}
function init(){
loadData();applyTheme();
canvas=document.getElementById('goBoard');
ctx=canvas.getContext('2d');
canvas.addEventListener('click',boardClick);
window.addEventListener('resize',function(){if(game){initCanvas();drawBoard();}});
var maxW=Math.min(680,window.innerWidth-360);
canvas.width=maxW;canvas.height=maxW;
canvas.style.width=maxW+'px';canvas.style.height=maxW+'px';
ctx.fillStyle='#DCB35C';ctx.fillRect(0,0,maxW,maxW);
ctx.strokeStyle='#222';ctx.lineWidth=1;
var cs=maxW/10,pd=cs;
for(var i=0;i<9;i++){var p=pd+i*cs;ctx.beginPath();ctx.moveTo(pd,p);ctx.lineTo(pd+8*cs,p);ctx.stroke();ctx.beginPath();ctx.moveTo(p,pd);ctx.lineTo(p,pd+8*cs);ctx.stroke();}
[2,4,6].forEach(function(si){[2,4,6].forEach(function(sj){ctx.beginPath();ctx.arc(pd+sj*cs,pd+si*cs,3,0,Math.PI*2);ctx.fillStyle='#222';ctx.fill();});});

updateUI();
initSplash();
setTimeout(function(){if(!splashDismissed)dismissSplash();},3000);
}

init();
</script>
