ctx.fill();
}
}

function boardClick(e){
if(!game||game.gameOver)return;
if(game.currentPlayer!==game.playerColor)return;
var rect=canvas.getBoundingClientRect();
var scaleX=canvas.width/rect.width,scaleY=canvas.height/rect.height;
var mx=(e.clientX-rect.left)*scaleX,my=(e.clientY-rect.top)*scaleY;
var cellSize=canvas.width/(game.size+1);
var pad=cellSize;
var col=Math.round((mx-pad)/cellSize);
var row=Math.round((my-pad)/cellSize);
if(col<0||col>=game.size||row<0||row>=game.size)return;
if(!isValidMove(game,row,col,game.playerColor))return;

game.consecutivePasses=0;
var result=placeStone(game,row,col,game.playerColor);
game.moveHistory.push({type:'move',x:row,y:col,color:game.playerColor,captured:result.captured});
game.moveNum++;
game.lastMove=[row,col];
if(result.captured===1){
var ko=result.capStones[0];
var ownGrp=getGroup(game,row,col);
if(ownGrp.stones.length===1)game.ko=[ko[0],ko[1]];else game.ko=null;
}else game.ko=null;

var comment=generateAIComment(game,row,col,game.playerColor,result);
game.aiComments.push({moveNum:game.moveNum,text:comment});

if(result.captured>0)playCaptureSound(result.captured);else playSound('stone');
drawBoard();updateInfo();

if(!game.gameOver){
game.currentPlayer=game.aiColor;
setTimeout(function(){
aiMove(game);
if(!game.gameOver)game.currentPlayer=game.playerColor;
drawBoard();updateInfo();
},400);
}
}
