function toggleAnalysis(){analysisMode=!analysisMode;drawBoard();addSystemMessage(analysisMode?t('sys_analysis_on'):t('sys_analysis_off'));}
function toggleCoords(){showCoords=!showCoords;drawBoard();}
function downloadSGF(){const letters='abcdefghijklmnopqrs';let sgf='(;GM[1]FF[4]CA[UTF-8]SZ['+boardSize+']KM['+document.getElementById('komi').value+']RU['+document.getElementById('rules').value+']';sgf+='PB['+(playerColor==='black'?session.name:selectedAI.name)+']PW['+(playerColor==='white'?session.name:selectedAI.name)+']';sgf+='DT['+new Date().toISOString().split('T')[0]+']\n';moveHistory.forEach(m=>{if(m.row===-1){sgf+=';'+(m.color===1?'B':'W')+'[]';return;}sgf+=';'+(m.color===1?'B':'W')+'['+letters[m.col]+letters[m.row]+']';});sgf+=')';triggerDownload('game.sgf',sgf,'application/x-go-sgf');}
function downloadText(){let text='=== Go Game Record ===\nDate: '+new Date().toLocaleString()+'\nBlack: '+document.getElementById('blackName').textContent+' ('+document.getElementById('blackRank').textContent+')\nWhite: '+document.getElementById('whiteName').textContent+' ('+document.getElementById('whiteRank').textContent+')\nBoard: '+boardSize+'x'+boardSize+'\nRules: '+document.getElementById('rules').value+'\nKomi: '+document.getElementById('komi').value+'\n================================\n\n';moveHistory.forEach((m,i)=>{const e={excellent:'★',good:'+',ok:'~',dubious:'?',bad:'✗'};text+=(i+1)+'. '+(m.color===1?'B':'W')+': '+m.label+(m.captured?' (cap: '+m.captured+')':'')+' ['+(e[m.eval]||'~')+']';if(m.analysis&&m.analysis.reasons.length>0)text+=' — '+m.analysis.reasons.join(', ');text+='\n';});triggerDownload('game_go.txt',text,'text/plain;charset=utf-8');}
function downloadPNG(){drawBoard();canvas.toBlob(function(blob){if(!blob)return;const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='go_board.png';document.body.appendChild(a);a.click();document.body.removeChild(a);setTimeout(()=>URL.revokeObjectURL(url),1000);},'image/png');}
function downloadJSON(){const data={date:new Date().toISOString(),boardSize,rules:document.getElementById('rules').value,komi:document.getElementById('komi').value,black:{name:document.getElementById('blackName').textContent,rank:document.getElementById('blackRank').textContent},white:{name:document.getElementById('whiteName').textContent,rank:document.getElementById('whiteRank').textContent},moves:moveHistory.map(m=>({move:m.label,color:m.color===1?'B':'W',captured:m.captured,eval:m.eval,reasons:m.analysis?m.analysis.reasons:[]})),captures:{black:capturedBlack,white:capturedWhite},territory:countTerritory()};triggerDownload('game_go.json',JSON.stringify(data,null,2),'application/json');}
function triggerDownload(filename,content,mimeType){const blob=new Blob([content],{type:mimeType});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=filename;a.style.display='none';document.body.appendChild(a);a.click();document.body.removeChild(a);setTimeout(()=>URL.revokeObjectURL(url),3000);}
function showModal(id){document.getElementById(id).classList.add('active');}
function hideModal(id){document.getElementById(id).classList.remove('active');}
document.querySelectorAll('.modal-overlay').forEach(m=>{m.addEventListener('click',e=>{if(e.target===m&&m.id!=='policyModal')m.classList.remove('active');});});
function checkPolicy(){
  const accepted=localStorage.getItem('gomaster_policy_accepted');
  if(!accepted){showModal('policyModal');const cb=document.getElementById('policyAgree'),btn=document.getElementById('policyAcceptBtn');cb.addEventListener('change',function(){btn.disabled=!cb.checked;btn.style.opacity=cb.checked?'1':'0.5';btn.style.cursor=cb.checked?'pointer':'not-allowed';});return false;}
  return true;
}
function acceptPolicy(){const cb=document.getElementById('policyAgree');if(!cb.checked)return;localStorage.setItem('gomaster_policy_accepted','1');hideModal('policyModal');showModal('newGameModal');}
function init(){
  loadSettings();applyI18n();loadSession();renderAIList();
  boardSize=19;board=Array.from({length:boardSize},()=>Array(boardSize).fill(0));
  boardStates=[JSON.parse(JSON.stringify(board))];resizeBoard();drawBoard();
  window.addEventListener('resize',()=>{resizeBoard();drawBoard();});
  if(!checkPolicy()){}else{showModal('newGameModal');}
}
init();
</script>
</body>
</html>
