<title>Go Game Service</title>
<style>
:root{--bg:#fff;--bg2:#f8f8f8;--bg3:#f0f0f0;--text:#222;--text2:#555;--border:#ddd;--accent:#336699;--accent2:#4a90d9;--btn:#f5f5f5;--btn-border:#ccc;--btn-hover:#e8e8e8;--panel:#fff;--input-bg:#fff;--font:'Verdana',sans-serif;--radius:2px;--shadow:none;--board-bg:#DCB35C;--board-line:#222;--transition:none}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:var(--font);background:var(--bg);color:var(--text);font-size:13px;transition:var(--transition)}
.topbar{background:var(--bg2);border-bottom:1px solid var(--border);padding:4px 12px;display:flex;align-items:center;justify-content:space-between;font-size:12px}
.topbar button{background:var(--btn);border:1px solid var(--btn-border);padding:3px 10px;cursor:pointer;font-size:11px;border-radius:var(--radius);color:var(--text)}
.topbar button:hover{background:var(--btn-hover)}
.main-area{display:flex;gap:8px;padding:8px;justify-content:center;align-items:flex-start}
.board-section{display:flex;flex-direction:column;align-items:center}
.players-bar{display:flex;justify-content:space-between;width:100%;max-width:680px;margin-bottom:4px;gap:8px}
.player-info{flex:1;background:var(--panel);border:1px solid var(--border);padding:6px 10px;border-radius:var(--radius);font-size:12px;display:flex;justify-content:space-between;align-items:center}
.player-info.active{background:#f0f5ff;border-color:var(--accent)}
.player-info .pname{font-weight:bold}
.player-info .ptime{font-family:monospace;font-size:14px}
.board-container{position:relative}
canvas#goBoard{border:1px solid var(--border);cursor:crosshair;border-radius:var(--radius)}
.controls{display:flex;gap:4px;margin-top:6px;flex-wrap:wrap;justify-content:center}
.controls button{background:var(--btn);border:1px solid var(--btn-border);padding:4px 12px;cursor:pointer;font-size:11px;border-radius:var(--radius);color:var(--text)}
.controls button:hover{background:var(--btn-hover)}
.side-panel{width:320px;background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);display:flex;flex-direction:column;height:600px}
.tabs{display:flex;border-bottom:1px solid var(--border);flex-wrap:wrap}
.tab{padding:5px 8px;cursor:pointer;font-size:11px;border-bottom:2px solid transparent;color:var(--text2);white-space:nowrap}
.tab:hover{color:var(--text)}
.tab.active{color:var(--accent);border-bottom-color:var(--accent);font-weight:bold}
.tab-content{flex:1;overflow-y:auto;padding:8px;font-size:12px;line-height:1.5}
.tab-content h3{margin:0 0 6px;font-size:13px;color:var(--accent)}
.move-list{list-style:none}
.move-list li{padding:2px 4px;border-bottom:1px solid var(--bg3)}
.modal-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;z-index:1000}
.modal{background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);padding:20px;max-width:560px;width:90%;max-height:85vh;overflow-y:auto;color:var(--text)}
.modal h2{margin:0 0 12px;font-size:16px;color:var(--accent)}
.modal label{display:block;margin:6px 0 3px;font-size:12px}
.modal select,.modal input[type=text],.modal input[type=password]{width:100%;padding:4px 6px;border:1px solid var(--btn-border);background:var(--input-bg);font-size:12px;border-radius:var(--radius);color:var(--text)}
.modal button{background:var(--btn);border:1px solid var(--btn-border);padding:5px 16px;cursor:pointer;font-size:12px;margin:4px 2px;border-radius:var(--radius);color:var(--text)}
.modal button.primary{background:var(--accent);color:#fff;border-color:var(--accent)}
.modal button.primary:hover{background:var(--accent2)}
.statusbar{background:var(--bg2);border-top:1px solid var(--border);padding:4px 12px;font-size:10px;color:var(--text2);display:flex;justify-content:space-between;position:fixed;bottom:0;left:0;right:0}
.statusbar a{color:var(--accent);cursor:pointer;text-decoration:underline}
#toast-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.3);display:none;align-items:center;justify-content:center;z-index:8000}
#toast-box{background:var(--panel);border:2px solid var(--accent);padding:20px 30px;border-radius:var(--radius);text-align:center;max-width:400px;color:var(--text)}
#toast-box button{margin-top:10px;padding:5px 20px}
#floatLicBtn{position:fixed;bottom:40px;right:10px;background:#4CAF50;color:#fff;border:none;padding:8px 14px;cursor:pointer;border-radius:4px;font-size:12px;z-index:900;display:none}
.badge-pro{display:inline-flex;align-items:center;gap:5px;background:linear-gradient(135deg,#1a5c2e,#2d8f4e);color:#fff;font-weight:bold;font-size:10px;padding:3px 10px;border-radius:12px;text-transform:uppercase}
.badge-pro svg{width:14px;height:14px;fill:none;stroke:#ffd700;stroke-width:2}
.badge-free{display:inline-flex;align-items:center;gap:4px;background:linear-gradient(135deg,#8b0000,#c0392b);color:#fff;font-weight:bold;font-size:10px;padding:3px 10px;border-radius:12px;text-transform:uppercase}
.badge-free svg{width:13px;height:13px;fill:none;stroke:#fff;stroke-width:2}
body.theme-cyber{--bg:#0a0a1a;--bg2:#111128;--bg3:#1a1a3e;--text:#0ff;--text2:#0aa;--border:#0ff3;--accent:#0ff;--accent2:#0af;--btn:#1a1a3e;--btn-border:#0ff5;--btn-hover:#2a2a5e;--panel:#0d0d25;--input-bg:#1a1a3e;--board-bg:#1a1a3e;--board-line:#0ff;--font:'Courier New',monospace;--transition:all .3s}
body.theme-hacker{--bg:#000;--bg2:#0a0a0a;--bg3:#111;--text:#0f0;--text2:#0a0;--border:#0f03;--accent:#0f0;--accent2:#0d0;--btn:#111;--btn-border:#0f05;--btn-hover:#1a1a1a;--panel:#050505;--input-bg:#111;--board-bg:#0a0a0a;--board-line:#0f0;--font:'Courier New',monospace;--transition:all .3s}
body.theme-modern{--bg:#fafbfc;--bg2:#fff;--bg3:#f0f2f5;--text:#1a1a2e;--text2:#6b7280;--border:#e5e7eb;--accent:#6366f1;--accent2:#818cf8;--btn:#f9fafb;--btn-border:#d1d5db;--btn-hover:#f3f4f6;--panel:#fff;--input-bg:#fff;--radius:8px;--transition:all .3s}
body.theme-vapor{--bg:#1a0a2e;--bg2:#2d1b4e;--bg3:#3d2b5e;--text:#ff71ce;--text2:#b967ff;--border:#ff71ce33;--accent:#01cdfe;--accent2:#05ffa1;--btn:#2d1b4e;--btn-border:#ff71ce55;--btn-hover:#4d3b7e;--panel:#1a0a2e;--input-bg:#2d1b4e;--board-bg:#2d1b4e;--board-line:#ff71ce;--font:'Georgia',serif;--transition:all .4s}
body.theme-terminal{--bg:#0c0c0c;--bg2:#1a1a1a;--bg3:#222;--text:#33ff33;--text2:#22aa22;--border:#33ff3322;--accent:#33ff33;--accent2:#66ff66;--btn:#1a1a1a;--btn-border:#33ff3344;--btn-hover:#2a2a2a;--panel:#0c0c0c;--input-bg:#1a1a1a;--board-bg:#111;--board-line:#33ff33;--font:'Courier New',monospace;--transition:all .2s}
body.theme-paper{--bg:#f5f0e8;--bg2:#ede7d9;--bg3:#e5dfd1;--text:#3e3529;--text2:#7a6f5f;--border:#c9c0ae;--accent:#8b4513;--accent2:#a0522d;--btn:#ede7d9;--btn-border:#c9c0ae;--btn-hover:#e5dfd1;--panel:#f5f0e8;--input-bg:#faf7f0;--board-bg:#d4a847;--board-line:#3e3529;--font:'Georgia',serif;--transition:all .3s}
#secretPanel{position:fixed;bottom:50px;left:10px;z-index:999999;pointer-events:auto;user-select:text;-webkit-user-select:text}
@font-face{font-family:'Pixel';src:url('data:font/woff2;base64,') format('woff2')}
#splash{position:fixed;top:0;left:0;width:100%;height:100%;z-index:100000;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;overflow:hidden}
#splash .bg{position:absolute;top:0;left:0;width:100%;height:100%;background:#000}
#splash .board-pattern{position:absolute;top:0;left:0;width:100%;height:100%;opacity:0.08}
#splash .stones-float{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none}
#splash .stone-f{position:absolute;border-radius:50%;animation:floatStone 8s ease-in-out infinite}
@keyframes floatStone{0%,100%{transform:translateY(0) scale(1);opacity:0.15}50%{transform:translateY(-30px) scale(1.1);opacity:0.3}}
#splash .studio-name{font-family:'Courier New',monospace;font-size:16px;letter-spacing:6px;color:#8b7355;text-transform:uppercase;margin-bottom:8px;opacity:0;animation:fadeSlideIn 0.8s ease 0.3s forwards;text-shadow:0 0 20px rgba(139,115,85,0.3);position:relative;z-index:2}
#splash .logo-container{position:relative;z-index:2;margin-bottom:20px;opacity:0;animation:fadeSlideIn 0.8s ease 0.6s forwards}
#splash .go-board-logo{display:grid;grid-template-columns:repeat(5,1fr);gap:3px;padding:15px;background:linear-gradient(145deg,#c8a84e,#a08030);border-radius:4px;box-shadow:0 8px 32px rgba(0,0,0,0.5),inset 0 1px 0 rgba(255,255,255,0.15);image-rendering:pixelated}
#splash .logo-cell{width:18px;height:18px;border-radius:50%;transition:all 0.3s}
#splash .logo-cell.black{background:radial-gradient(circle at 35% 35%,#555,#000);box-shadow:1px 1px 3px rgba(0,0,0,0.5)}
#splash .logo-cell.white{background:radial-gradient(circle at 35% 35%,#fff,#ccc);box-shadow:1px 1px 3px rgba(0,0,0,0.3)}
#splash .logo-cell.empty{background:transparent}
#splash .title{font-family:'Courier New',monospace;font-size:42px;font-weight:bold;color:#e8d5a3;letter-spacing:4px;position:relative;z-index:2;opacity:0;animation:fadeSlideIn 0.8s ease 0.9s forwards;text-shadow:0 0 40px rgba(232,213,163,0.3),0 2px 0 #8b7355;image-rendering:pixelated}
#splash .title span{color:#fff;text-shadow:0 0 20px rgba(255,255,255,0.5)}

@keyframes fadeSlideIn{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}
#splash .line-decor{width:200px;height:1px;background:linear-gradient(90deg,transparent,#8b7355,transparent);margin:10px 0;position:relative;z-index:2;opacity:0;animation:fadeSlideIn 0.6s ease 1.2s forwards}
#splash.fade-out{animation:splashOut 0.6s ease forwards}
@keyframes splashOut{to{opacity:0;transform:scale(1.02)}}
</style>
</head>
