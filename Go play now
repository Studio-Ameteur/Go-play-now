function undoMove(){
if(!game||game.gameOver||game.moveHistory.length<2)return;
game.moveHistory.pop();game.moveHistory.pop();
game.moveNum=game.moveHistory.length;
var board=[];for(var i=0;i<game.size;i++){board[i]=[];for(var j=0;j<game.size;j++)board[i][j]=0;}
game.board=board;game.capturedBlack=0;game.capturedWhite=0;game.ko=null;
if(game.handicap>=2)placeHandicap(game);
var hist=game.moveHistory.slice();game.moveHistory=[];
hist.forEach(function(m){
if(m.type==='move'){
var caps=placeStone(game,m.x,m.y,m.color);
game.moveHistory.push({type:'move',x:m.x,y:m.y,color:m.color,captured:caps.captured});
}else{game.moveHistory.push(m);}
});
game.lastMove=null;
for(var i=game.moveHistory.length-1;i>=0;i--){
if(game.moveHistory[i].type==='move'){game.lastMove=[game.moveHistory[i].x,game.moveHistory[i].y];break;}
}
game.currentPlayer=game.playerColor;drawBoard();updateInfo();
}
