function drawBoard(){
if(!game||!ctx)return;
var w=canvas.width,h=canvas.height;
var size=game.size;
var cellSize=w/(size+1);
var pad=cellSize;

ctx.fillStyle=getComputedStyle(document.body).getPropertyValue('--board-bg').trim()||'#DCB35C';
ctx.fillRect(0,0,w,h);

ctx.strokeStyle=getComputedStyle(document.body).getPropertyValue('--board-line').trim()||'#222';
ctx.lineWidth=1;
for(var i=0;i<size;i++){
var p=pad+i*cellSize;
ctx.beginPath();ctx.moveTo(pad,p);ctx.lineTo(pad+(size-1)*cellSize,p);ctx.stroke();
ctx.beginPath();ctx.moveTo(p,pad);ctx.lineTo(p,pad+(size-1)*cellSize);ctx.stroke();
}
var sp={9:[[2,2],[2,6],[6,2],[6,6],[4,4]],13:[[3,3],[3,9],[9,3],[9,9],[6,6],[3,6],[9,6],[6,3],[6,9]],19:[[3,3],[3,9],[3,15],[9,3],[9,9],[9,15],[15,3],[15,9],[15,15]]};
var stars=sp[size]||[];
ctx.fillStyle=getComputedStyle(document.body).getPropertyValue('--board-line').trim()||'#222';
stars.forEach(function(s){
ctx.beginPath();ctx.arc(pad+s[1]*cellSize,pad+s[0]*cellSize,3,0,Math.PI*2);ctx.fill();
});
ctx.fillStyle=getComputedStyle(document.body).getPropertyValue('--text2').trim()||'#555';
ctx.font='10px Verdana';ctx.textAlign='center';ctx.textBaseline='middle';
var letters='ABCDEFGHJKLMNOPQRST';
for(var i=0;i<size;i++){
ctx.fillText(letters[i],pad+i*cellSize,pad/3);
ctx.fillText(letters[i],pad+i*cellSize,h-pad/3);
ctx.fillText(''+(i+1),pad/3,pad+i*cellSize);
ctx.fillText(''+(i+1),w-pad/3,pad+i*cellSize);
}
var stoneR=cellSize*0.45;
for(var r=0;r<size;r++)for(var c=0;c<size;c++){
if(game.board[r][c]===0)continue;
var cx=pad+c*cellSize,cy=pad+r*cellSize;
if(game.board[r][c]===1){
var grad=ctx.createRadialGradient(cx-stoneR*0.3,cy-stoneR*0.3,stoneR*0.1,cx,cy,stoneR);
grad.addColorStop(0,'#555');grad.addColorStop(1,'#000');
ctx.beginPath();ctx.arc(cx,cy,stoneR,0,Math.PI*2);ctx.fillStyle=grad;ctx.fill();
ctx.strokeStyle='#000';ctx.lineWidth=0.5;ctx.stroke();
}else{
var grad=ctx.createRadialGradient(cx-stoneR*0.3,cy-stoneR*0.3,stoneR*0.1,cx,cy,stoneR);
grad.addColorStop(0,'#fff');grad.addColorStop(1,'#bbb');
ctx.beginPath();ctx.arc(cx,cy,stoneR,0,Math.PI*2);ctx.fillStyle=grad;ctx.fill();
ctx.strokeStyle='#888';ctx.lineWidth=0.5;ctx.stroke();
}
}
if(game.lastMove){
var lx=pad+game.lastMove[1]*cellSize,ly=pad+game.lastMove[0]*cellSize;
ctx.beginPath();ctx.arc(lx,ly,stoneR*0.25,0,Math.PI*2);
