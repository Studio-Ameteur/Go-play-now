function getAIMove(){
  const color=currentPlayer,level=selectedAI.level,valid=[];computeInfluence();
  for(let r=0;r<boardSize;r++)for(let c=0;c<boardSize;c++){if(isValidMove(r,c,color))valid.push({r,c,score:scoreAIMoveDeep(r,c,color,level)});}
  if(valid.length===0)return null;valid.sort((a,b)=>b.score-a.score);
  const topR=Math.max(0.02,0.6-level*0.05),topN=Math.max(1,Math.floor(valid.length*topR)),cands=valid.slice(0,topN);
  if(level>=8){if(Math.random()<0.85)return cands[0];return cands[Math.floor(Math.random()*Math.min(3,cands.length))];}
  if(level>=5)return cands[Math.floor(Math.random()*Math.min(5,cands.length))];
  return cands[Math.floor(Math.random()*cands.length)];
}
function scoreAIMoveDeep(r,c,color,level){
  let score=0;const op=opp(color),distEdge=Math.min(r,c,boardSize-1-r,boardSize-1-c),moveNum=moveHistory.length;
  const phase=moveNum<8?'opening':(moveNum>boardSize*boardSize*0.4?'endgame':'midgame');
  board[r][c]=color;let capC=0;
  for(const[dr,dc]of DIRS){const nr=r+dr,nc=c+dc;if(inBounds(nr,nc)&&board[nr][nc]===op){const g=getGroup(nr,nc);if(g.liberties===0)capC+=g.stones.length;}}
  board[r][c]=0;score+=capC*20;
  let saveS=0;
  for(const[dr,dc]of DIRS){const nr=r+dr,nc=c+dc;if(inBounds(nr,nc)&&board[nr][nc]===color){const g=getGroup(nr,nc);if(g.liberties===1)saveS+=g.stones.length*15;else if(g.liberties===2)saveS+=g.stones.length*3;}}
  score+=saveS;
  board[r][c]=color;let atariS=0;
  for(const[dr,dc]of DIRS){const nr=r+dr,nc=c+dc;if(inBounds(nr,nc)&&board[nr][nc]===op){const g=getGroup(nr,nc);if(g.liberties===1)atariS+=g.stones.length*8;else if(g.liberties===2)atariS+=g.stones.length*2;}}
  board[r][c]=0;score+=atariS;
  if(phase==='opening'){
    const stars=getStarPoints();for(const[sr,sc]of stars)if(r===sr&&c===sc){score+=18;break;}
    if(distEdge>=2&&distEdge<=4)score+=10;if(distEdge===0)score-=20;if(distEdge===1)score-=8;
    let nearOwn=0;for(let dr=-2;dr<=2;dr++)for(let dc=-2;dc<=2;dc++){if(inBounds(r+dr,c+dc)&&board[r+dr][c+dc]===color)nearOwn++;}
    if(nearOwn>0&&moveNum<6)score-=nearOwn*3;
  }
  if(influenceMap){const inf=influenceMap[r][c];const mySign=color===1?1:-1;if(Math.abs(inf)<0.4)score+=5;if(inf*mySign<-0.5)score+=(level>=6?8:3);if(inf*mySign>1.5&&capC===0&&saveS===0)score-=12;}
  let ownAdj=0,oppAdj=0,emptyAdj=0,ownDiag=0;
  for(const[dr,dc]of DIRS){const nr=r+dr,nc=c+dc;if(inBounds(nr,nc)){if(board[nr][nc]===color)ownAdj++;else if(board[nr][nc]===op)oppAdj++;else emptyAdj++;}}
  for(const[dr,dc]of DIAGS){const nr=r+dr,nc=c+dc;if(inBounds(nr,nc)&&board[nr][nc]===color)ownDiag++;}
  if(ownAdj===1&&emptyAdj>=2)score+=4;if(ownDiag>=1&&ownAdj===0&&emptyAdj>=3)score+=5;if(ownAdj>=2&&ownDiag>=1)score-=3;if(oppAdj>=1&&level>=4)score+=2;
  if(distEdge===0&&phase!=='endgame'&&capC===0)score-=12;if(distEdge===1&&phase==='opening')score-=5;
  if(phase==='midgame'){const center=Math.floor(boardSize/2);if(Math.abs(r-center)+Math.abs(c-center)<boardSize/3)score+=2;}
  if(level>=7&&capC===0){
    board[r][c]=color;let worst=0;
    for(const[dr,dc]of DIRS){for(let d2=-1;d2<=1;d2++){const nr=r+dr+(dr===0?d2:0),nc=c+dc+(dc===0?d2:0);if(!inBounds(nr,nc)||board[nr][nc]!==0)continue;board[nr][nc]=op;const mg=getGroup(r,c);if(mg.liberties===0)worst=Math.max(worst,mg.stones.length*10);board[nr][nc]=0;}}
    board[r][c]=0;score-=worst*0.5;
  }
  const style=selectedAI.style;
  if(style==='aggressive'){score+=atariS*0.5+capC*5;if(oppAdj>=1)score+=3;}
  else if(style==='cautious'){score+=saveS*0.3;if(distEdge<=1)score-=3;}
  else if(style==='territorial'){if(distEdge>=2&&distEdge<=4)score+=4;if(phase==='endgame')score+=3;}
  else if(style==='influence'){const center=Math.floor(boardSize/2);if(Math.abs(r-center)+Math.abs(c-center)<boardSize/2.5)score+=4;}
  else if(style==='positional'){if(ownAdj===1&&emptyAdj>=2)score+=3;if(ownDiag>=1&&ownAdj===0)score+=3;}
  score+=Math.random()*Math.max(1,14-level*1.2);return score;
}
function startGame(){
  playerColor=document.getElementById('playerColor').value;
  timeControl=parseInt(document.getElementById('timeControl').value);
  const handicap=parseInt(document.getElementById('handicap').value);
  initBoard();gameActive=true;
  if(playerColor==='black'){
    document.getElementById('blackName').textContent=session.name;document.getElementById('blackRank').textContent=eloToRank(session.elo);
    document.getElementById('whiteName').textContent=selectedAI.name;document.getElementById('whiteRank').textContent=selectedAI.rank;
  }else{
    document.getElementById('whiteName').textContent=session.name;document.getElementById('whiteRank').textContent=eloToRank(session.elo);
    document.getElementById('blackName').textContent=selectedAI.name;document.getElementById('blackRank').textContent=selectedAI.rank;
  }
  if(handicap>=2){const hP=getHandicapPoints(handicap);hP.forEach(([r,c])=>{board[r][c]=1;});currentPlayer=2;boardStates=[JSON.parse(JSON.stringify(board))];document.getElementById('komi').value='0.5';}
  if(timeControl>0){blackTime=timeControl;whiteTime=timeControl;updateTimerDisplay();if(timerInterval)clearInterval(timerInterval);timerInterval=setInterval(tickTimer,1000);}
  else{document.getElementById('blackTimer').textContent='∞';document.getElementById('whiteTimer').textContent='∞';}
  gameStartTime=Date.now();if(gameElapsedInterval)clearInterval(gameElapsedInterval);gameElapsedInterval=setInterval(updateGameElapsed,1000);
  computeInfluence();updateActivePlayer();drawBoard();
  addSystemMessage(t('sys_game')+' '+session.name+' '+t('sys_vs')+' '+selectedAI.name+' ('+selectedAI.rank+')');
  addSystemMessage(boardSize+'×'+boardSize+', '+document.getElementById('rules').value+', '+t('sys_komi')+' '+document.getElementById('komi').value);
  if(handicap>=2)addSystemMessage(t('sys_handicap')+' '+handicap+' '+t('sys_stones'));
  document.getElementById('tipArea').textContent=t('sys_started');
  if((playerColor==='white'&&currentPlayer===1)||(playerColor==='black'&&currentPlayer===2))setTimeout(aiTurn,800);
}
function getHandicapPoints(n){const pts=[],hi=boardSize>=13?3:2,lo=boardSize>=13?boardSize-4:boardSize-3,mid=Math.floor(boardSize/2);const all=[[hi,lo],[lo,hi],[hi,hi],[lo,lo],[mid,mid],[hi,mid],[lo,mid],[mid,hi],[mid,lo]];for(let i=0;i<Math.min(n,all.length);i++)pts.push(all[i]);return pts;}
function updateActivePlayer(){document.getElementById('blackPanel').classList.toggle('active',currentPlayer===1);document.getElementById('whitePanel').classList.toggle('active',currentPlayer===2);}
function updateGameElapsed(){if(!gameStartTime)return;const s=Math.floor((Date.now()-gameStartTime)/1000),m=Math.floor(s/60),sec=s%60;document.getElementById('gameTimeDisplay').textContent=t('game_time')+': '+String(m).padStart(2,'0')+':'+String(sec).padStart(2,'0');}
function tickTimer(){if(!gameActive)return;if(currentPlayer===1){blackTime--;if(blackTime<=0){blackTime=0;endGame(playerColor==='black'?'loss':'win',t('sys_time_out'));}}else{whiteTime--;if(whiteTime<=0){whiteTime=0;endGame(playerColor==='white'?'loss':'win',t('sys_time_out'));}}updateTimerDisplay();}
function updateTimerDisplay(){const fmt=s=>{if(s<0)s=0;return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0')};document.getElementById('blackTimer').textContent=fmt(blackTime);document.getElementById('whiteTimer').textContent=fmt(whiteTime);}
function isPlayerTurn(){return playerColor==='black'?currentPlayer===1:currentPlayer===2}
function aiTurn(){
  if(!gameActive)return;document.getElementById('thinkingIndicator').classList.add('active');
  const delay=400+selectedAI.level*200+Math.random()*800;
  setTimeout(()=>{document.getElementById('thinkingIndicator').classList.remove('active');if(!gameActive)return;const move=getAIMove();if(!move){passMove(true);return;}placeStone(move.r,move.c,currentPlayer,true);currentPlayer=opp(currentPlayer);updateActivePlayer();},delay);
}
canvas.addEventListener('click',function(e){
