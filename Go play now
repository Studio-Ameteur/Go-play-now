<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Go Game</title>
<style>
:root{
--bg:#fff;--bg2:#f8f8f8;--bg3:#f5f5f5;--bg4:#f0f5ff;
--text:#333;--text2:#555;--text3:#777;--text4:#999;--text5:#aaa;
--border:#e0e0e0;--border2:#ddd;--border3:#eee;--border4:#ccc;
--accent:#369;--accent2:#89a;--accent-bg:#eef3f8;--accent-light:#f0f5ff;
--btn-bg:#f5f5f5;--btn-border:#bbb;--btn-hover:#fff;
--btn-blue-bg:#e8f0f8;--btn-blue-border:#a0b8d0;
--btn-red-bg:#fcecea;--btn-red-border:#d0a0a0;
--btn-green-bg:#eaf8ea;--btn-green-border:#a0d0a0;
--good:#282;--ok:#a80;--bad:#c33;--clock:#833;
--modal-overlay:rgba(0,0,0,0.25);--shadow:0 2px 12px rgba(0,0,0,0.1);
--board-color:#DCB468;--board-line:#444;--board-star:#444;--board-border:#8B6914;
--radius:0px;--transition:none;
--font:Verdana,Tahoma,Arial,sans-serif;--mono:'Courier New',monospace;
}
body.theme-cyber{
--bg:#0a0a1a;--bg2:#111128;--bg3:#161638;--bg4:#1a1a40;
--text:#0ff;--text2:#0cc;--text3:#099;--text4:#066;--text5:#044;
--border:#0ff3;--border2:#0ff2;--border3:#0ff1;--border4:#0ff4;
--accent:#f0f;--accent2:#c0c;--accent-bg:#1a0a2a;--accent-light:#1a1a40;
--btn-bg:#111128;--btn-border:#0ff6;--btn-hover:#1a1a40;
--btn-blue-bg:#0a0a2a;--btn-blue-border:#00f8;--btn-red-bg:#2a0a0a;--btn-red-border:#f008;
--btn-green-bg:#0a2a0a;--btn-green-border:#0f08;
--good:#0f0;--ok:#ff0;--bad:#f00;--clock:#f0f;
--modal-overlay:rgba(0,0,0,0.7);--shadow:0 0 30px rgba(0,255,255,0.2);
--board-color:#1a1a2e;--board-line:#0ff8;--board-star:#0ff;--board-border:#0ff;
--radius:0px;--transition:none;
}
body.theme-hacker{
--bg:#0a0a0a;--bg2:#0d0d0d;--bg3:#111;--bg4:#1a1a1a;
--text:#0f0;--text2:#0c0;--text3:#090;--text4:#060;--text5:#040;
--border:#0f03;--border2:#0f02;--border3:#0f01;--border4:#0f04;
--accent:#0f0;--accent2:#0c0;--accent-bg:#0a1a0a;--accent-light:#0d1a0d;
--btn-bg:#111;--btn-border:#0f04;--btn-hover:#1a1a1a;
--btn-blue-bg:#0a1a0a;--btn-blue-border:#0f06;--btn-red-bg:#1a0a0a;--btn-red-border:#f006;
--btn-green-bg:#0a1a0a;--btn-green-border:#0f06;
--good:#0f0;--ok:#ff0;--bad:#f00;--clock:#0f0;
--modal-overlay:rgba(0,0,0,0.8);--shadow:0 0 20px rgba(0,255,0,0.15);
--board-color:#0d1a0d;--board-line:#0f06;--board-star:#0f0;--board-border:#0f0;
--radius:0px;--transition:none;
--font:'Courier New',Consolas,monospace;
}
body.theme-modern{
--bg:#fafbfc;--bg2:#fff;--bg3:#f6f8fa;--bg4:#f0f4ff;
--text:#1a1a2e;--text2:#4a4a5a;--text3:#7a7a8a;--text4:#9a9aaa;--text5:#babaca;
--border:#e1e4e8;--border2:#d1d5da;--border3:#eaecef;--border4:#c8ccd0;
--accent:#0366d6;--accent2:#2188ff;--accent-bg:#f1f8ff;--accent-light:#e8f4fd;
--btn-bg:#fafbfc;--btn-border:#d1d5da;--btn-hover:#fff;
--btn-blue-bg:#f1f8ff;--btn-blue-border:#79b8ff;--btn-red-bg:#ffeef0;--btn-red-border:#f97583;
--btn-green-bg:#dcffe4;--btn-green-border:#34d058;
--good:#22863a;--ok:#b08800;--bad:#cb2431;--clock:#0366d6;
--modal-overlay:rgba(0,0,0,0.3);--shadow:0 8px 30px rgba(0,0,0,0.12);
--board-color:#DCB468;--board-line:#444;--board-star:#444;--board-border:#8B6914;
--radius:8px;--transition:all 0.2s ease;
}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--text);font-family:var(--font);font-size:12px;min-height:100vh;transition:var(--transition)}
a{color:var(--accent);text-decoration:underline}a:hover{color:var(--bad)}
.top-bar{background:var(--bg2);border-bottom:1px solid var(--border);padding:3px 10px;display:flex;align-items:center;justify-content:space-between;font-size:11px;color:var(--text2)}
.top-bar b{color:var(--text)}
.top-bar .user-info{display:flex;gap:10px;align-items:center}
.btn{padding:3px 10px;border:1px solid var(--btn-border);background:var(--btn-bg);color:var(--text);cursor:pointer;font-size:11px;font-family:var(--font);border-radius:var(--radius);transition:var(--transition)}
.btn:hover{background:var(--btn-hover);border-color:var(--border4)}.btn:active{opacity:.8}
.btn-blue{background:var(--btn-blue-bg);border-color:var(--btn-blue-border)}
.btn-red{background:var(--btn-red-bg);border-color:var(--btn-red-border)}
.btn-green{background:var(--btn-green-bg);border-color:var(--btn-green-border)}
.game-wrapper{display:flex;justify-content:center;gap:0;padding:8px;align-items:flex-start}
.board-column{display:flex;flex-direction:column;align-items:center}
.clock-panel{display:flex;gap:0;width:100%;max-width:700px;margin-bottom:4px}
.player-panel{flex:1;border:1px solid var(--border2);padding:5px 8px;display:flex;align-items:center;gap:6px;background:var(--bg);border-radius:var(--radius);transition:var(--transition)}
.player-panel.active{background:var(--bg4);border-color:var(--accent2)}
.player-panel .stone{width:14px;height:14px;border-radius:50%;display:inline-block;flex-shrink:0}
.stone-b{background:radial-gradient(circle at 35% 35%,#555,#000);border:1px solid #222}
.stone-w{background:radial-gradient(circle at 35% 35%,#fff,#ccc);border:1px solid #aaa}
.player-panel .pname{font-weight:bold;font-size:11px}.player-panel .prank{font-size:10px;color:var(--text3)}
.player-panel .pcapt{font-size:10px;color:var(--text4);margin-left:4px}
.player-panel .clock{margin-left:auto;font-family:var(--mono);font-size:14px;font-weight:bold;color:var(--clock);min-width:50px;text-align:right}
canvas#goBoard{cursor:crosshair;display:block;border-radius:var(--radius)}
.board-controls{display:flex;gap:3px;margin:5px 0;flex-wrap:wrap;justify-content:center;max-width:700px}
.analysis-bar{width:100%;max-width:700px;height:18px;background:var(--bg3);border:1px solid var(--border2);position:relative;overflow:hidden;margin:3px 0;border-radius:var(--radius)}
.analysis-fill{height:100%;transition:width .5s;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:bold;background:#555;color:#fff}
.eval-line{font-size:11px;text-align:center;min-height:16px;padding:2px;color:var(--text2)}
.thinking-indicator{display:none;align-items:center;gap:5px;padding:2px 8px;font-size:11px;color:var(--accent)}
.thinking-indicator.active{display:flex}
.thinking-dots span{animation:blink 1.4s infinite both;width:4px;height:4px;background:var(--accent);border-radius:50%;display:inline-block;margin:0 1px}
.thinking-dots span:nth-child(2){animation-delay:.2s}.thinking-dots span:nth-child(3){animation-delay:.4s}
@keyframes blink{0%,80%,100%{opacity:0}40%{opacity:1}}
.info-column{width:320px;min-width:280px;border:1px solid var(--border2);background:var(--bg);display:flex;flex-direction:column;max-height:calc(100vh - 50px);margin-left:8px;border-radius:var(--radius);overflow:hidden}
.tab-bar{display:flex;flex-wrap:wrap;border-bottom:1px solid var(--border2);background:var(--bg3)}
.tab-btn{padding:4px 8px;font-size:10px;cursor:pointer;border:none;background:transparent;font-family:var(--font);color:var(--text2);border-right:1px solid var(--border);transition:var(--transition)}
.tab-btn:hover{background:var(--bg);color:var(--text)}.tab-btn.active{background:var(--bg);color:var(--text);font-weight:bold;border-bottom:1px solid var(--bg);margin-bottom:-1px}
.tab-content{display:none;padding:8px;overflow-y:auto;flex:1;font-size:11px}.tab-content.active{display:block}
.move-list{font-family:var(--mono);font-size:11px;background:var(--bg);border:1px solid var(--border2);padding:3px;max-height:300px;overflow-y:auto}
.move-item{padding:1px 3px;display:flex;justify-content:space-between;border-bottom:1px solid var(--border3);cursor:pointer}
.move-item:hover{background:var(--accent-light)}.eval-good{color:var(--good)}.eval-ok{color:var(--ok)}.eval-bad{color:var(--bad)}
.chat-area{max-height:250px;overflow-y:auto;background:var(--bg);border:1px solid var(--border2);padding:3px;font-size:11px}
.chat-msg{margin-bottom:2px;padding:1px 0;border-bottom:1px solid var(--border3)}
.chat-msg .sender{color:var(--bad);font-weight:bold}.chat-msg .ai-sender{color:var(--accent);font-weight:bold}
.info-text{font-size:11px;line-height:1.6;color:var(--text2)}
.info-text h4{color:var(--accent);font-size:12px;margin:8px 0 4px;border-bottom:1px dotted var(--border2);padding-bottom:2px}
.info-text p{margin-bottom:6px}.info-text ul{margin-left:16px;margin-bottom:6px}
.setting-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:5px;font-size:11px}
.setting-row select,.setting-row input[type=checkbox]{background:var(--bg);border:1px solid var(--border4);color:var(--text);padding:2px 4px;font-size:11px;font-family:var(--font);border-radius:var(--radius)}
.setting-row select{min-width:100px}
.modal-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:var(--modal-overlay);z-index:1000;display:none;align-items:center;justify-content:center}
.modal-overlay.active{display:flex}
.modal{background:var(--bg);border:1px solid var(--border4);padding:14px;max-width:620px;width:92%;max-height:90vh;overflow-y:auto;box-shadow:var(--shadow);border-radius:var(--radius);color:var(--text)}
.modal h2{font-size:13px;color:var(--accent);margin-bottom:10px;text-align:center;border-bottom:1px solid var(--border3);padding-bottom:5px}
.modal-section{margin-bottom:10px}.modal-section h3{font-size:11px;color:var(--text2);margin-bottom:5px;font-weight:bold}
.ai-grid{display:grid;grid-template-columns:1fr 1fr;gap:4px;max-height:260px;overflow-y:auto;margin-bottom:8px}
.ai-card{display:flex;align-items:center;gap:5px;padding:4px 6px;border:1px solid var(--border2);cursor:pointer;background:var(--bg);font-size:10px;border-radius:var(--radius);transition:var(--transition)}
.ai-card:hover{background:var(--accent-light);border-color:var(--accent2)}
.ai-card.selected{background:var(--accent-bg);border-color:var(--accent2)}
.ai-avatar{width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;background:var(--bg3);border:1px solid var(--border2);flex-shrink:0}
.ai-card.selected .ai-avatar{border-color:var(--accent2);background:var(--accent-bg)}
.ai-info .ai-name{font-weight:bold;font-size:10px;color:var(--text)}.ai-info .ai-rank{font-size:9px;color:var(--text3)}.ai-info .ai-style{font-size:8px;color:var(--text5)}
.profile-stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-bottom:10px}
.stat-box{text-align:center;padding:6px;border:1px solid var(--border2);background:var(--bg);border-radius:var(--radius)}
.stat-box .val{font-size:16px;font-weight:bold;color:var(--accent)}.stat-box .lbl{font-size:9px;color:var(--text4);margin-top:2px}
.history-table{width:100%;border-collapse:collapse;font-size:10px}
.history-table th{background:var(--bg3);padding:3px 4px;text-align:left;border:1px solid var(--border2);color:var(--text)}
.history-table td{padding:2px 4px;border:1px solid var(--border3);background:var(--bg)}.history-table tr:hover td{background:var(--accent-light)}
.status-bar{position:fixed;bottom:0;left:0;right:0;background:var(--bg2);border-top:1px solid var(--border);padding:2px 10px;display:flex;justify-content:space-between;font-size:9px;color:var(--text3);z-index:100}
.move-nav{display:flex;gap:3px;align-items:center;margin:2px 0}
.music-btn{display:flex;align-items:center;gap:4px;cursor:pointer;font-size:10px;color:var(--text3);padding:2px 6px;border:1px solid var(--border2);background:var(--bg2);font-family:var(--font);border-radius:var(--radius);transition:var(--transition)}
.music-btn:hover{background:var(--bg);color:var(--text)}.music-btn.playing{color:var(--accent);border-color:var(--accent2);background:var(--accent-light)}
.vol-slider{width:50px;height:3px;cursor:pointer;vertical-align:middle}
.settings-group{margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid var(--border3)}
.settings-group:last-child{border-bottom:none}
.settings-group h3{font-size:11px;color:var(--accent);margin-bottom:6px;font-weight:bold}
.theme-preview{display:flex;gap:6px;flex-wrap:wrap}
.theme-card{padding:6px 10px;border:2px solid var(--border2);cursor:pointer;font-size:10px;text-align:center;min-width:70px;border-radius:var(--radius);transition:var(--transition)}
.theme-card:hover{border-color:var(--accent2)}.theme-card.selected{border-color:var(--accent);background:var(--accent-bg)}
::-webkit-scrollbar{width:8px}::-webkit-scrollbar-track{background:var(--bg3)}::-webkit-scrollbar-thumb{background:var(--border4)}::-webkit-scrollbar-thumb:hover{background:var(--text4)}
@media(max-width:900px){.game-wrapper{flex-direction:column;align-items:center}.info-column{width:100%;max-width:700px;margin-left:0;margin-top:8px;max-height:400px}}
</style>
</head>
<body>

<div class="top-bar">
  <div class="user-info">
    <span>&#9679; <b id="headerUser">—</b></span>
    <span>| <span id="headerRank">30 кю</span></span>
    <span>| <span id="headerWins">0</span><span data-i18n="w_slash">П</span>/<span id="headerLosses">0</span><span data-i18n="l_slash">П</span></span>
  </div>
  <div style="display:flex;gap:4px;align-items:center">
    <button class="music-btn" id="musicBtn" onclick="toggleMusic()" title="Music">&#9835; <span data-i18n="music">Музыка</span></button>
    <input type="range" class="vol-slider" id="volSlider" min="0" max="100" value="50" oninput="setMusicVolume(this.value)">
    <button class="btn" onclick="showModal('settingsModal')">&#9881; <span data-i18n="settings">Настройки</span></button>
    <button class="btn" onclick="showModal('profileModal')" data-i18n="profile">Профиль</button>
    <button class="btn btn-blue" onclick="showModal('newGameModal')" data-i18n="new_game">Новая игра</button>
  </div>
</div>

<div class="game-wrapper">
  <div class="board-column">
    <div class="clock-panel" id="clockPanel">
      <div class="player-panel active" id="blackPanel">
        <span class="stone stone-b"></span>
        <div><div class="pname" id="blackName">—</div><div class="prank" id="blackRank">—</div></div>
        <div class="pcapt" id="blackCapt"></div>
        <div class="clock" id="blackTimer">--:--</div>
      </div>
      <div class="player-panel" id="whitePanel">
        <span class="stone stone-w"></span>
        <div><div class="pname" id="whiteName">—</div><div class="prank" id="whiteRank">—</div></div>
        <div class="pcapt" id="whiteCapt"></div>
        <div class="clock" id="whiteTimer">--:--</div>
      </div>
    </div>
    <div class="thinking-indicator" id="thinkingIndicator">
      <span data-i18n="ai_thinking">ИИ думает</span><div class="thinking-dots"><span></span><span></span><span></span></div>
    </div>
    <canvas id="goBoard"></canvas>
    <div class="analysis-bar" id="analysisBar"><div class="analysis-fill" id="analysisFill" style="width:50%">50%</div></div>
    <div class="board-controls">
      <button class="btn" onclick="undoMove()">&#8617; <span data-i18n="undo">Отмена</span></button>
      <button class="btn" onclick="passMove()" data-i18n="pass">Пас</button>
      <button class="btn btn-red" onclick="resignGame()" data-i18n="resign">Сдаться</button>
      <button class="btn" onclick="toggleAnalysis()" data-i18n="analysis">Анализ</button>
      <button class="btn" onclick="toggleCoords()">A1</button>
      <button class="btn" onclick="showModal('downloadModal')">&#128190; <span data-i18n="save">Сохранить</span></button>
    </div>
    <div class="move-nav">
      <button class="btn" onclick="goToMove(0)">|&lt;</button>
      <button class="btn" onclick="goToMove(currentMoveIndex-1)">&lt;</button>
      <span id="moveCounter" style="font-family:var(--mono);font-size:11px;min-width:70px;text-align:center"><span data-i18n="move">Ход</span>: 0</span>
      <button class="btn" onclick="goToMove(currentMoveIndex+1)">&gt;</button>
      <button class="btn" onclick="goToMove(moveHistory.length-1)">&gt;|</button>
    </div>
    <div class="eval-line" id="lastMoveEval"></div>
  </div>

  <div class="info-column">
    <div class="tab-bar">
      <button class="tab-btn active" onclick="switchTab(this,'tabMoves')" data-i18n="moves_tab">Ходы</button>
      <button class="tab-btn" onclick="switchTab(this,'tabAnalysis')" data-i18n="eval_tab">Оценка</button>
      <button class="tab-btn" onclick="switchTab(this,'tabChat')" data-i18n="ai_tab">ИИ</button>
      <button class="tab-btn" onclick="switchTab(this,'tabRules')" data-i18n="rules_tab">Правила</button>
      <button class="tab-btn" onclick="switchTab(this,'tabHistory')" data-i18n="go_tab">Го</button>
      <button class="tab-btn" onclick="switchTab(this,'tabAIHow')" data-i18n="how_ai_tab">Как думает ИИ</button>
    </div>
    <div class="tab-content active" id="tabMoves"><div class="move-list" id="moveList"></div></div>
    <div class="tab-content" id="tabAnalysis">
      <div style="margin-bottom:6px">
        <div class="setting-row"><span data-i18n="terr_black">Территория Чёрных:</span><b id="evalBlack">0</b></div>
        <div class="setting-row"><span data-i18n="terr_white">Территория Белых:</span><b id="evalWhite">0</b></div>
        <div class="setting-row"><span data-i18n="capt_b">Пленные Ч:</span><span id="captBlack">0</span></div>
        <div class="setting-row"><span data-i18n="capt_w">Пленные Б:</span><span id="captWhite">0</span></div>
        <div class="setting-row"><span data-i18n="eval_lbl">Оценка:</span><b id="evalScore" style="color:var(--accent)" data-i18n="equal">Равная</b></div>
      </div>
      <div id="tipArea" style="color:var(--text4);border-top:1px dotted var(--border2);padding-top:6px" data-i18n="start_for_analysis">Начните игру для анализа.</div>
    </div>
    <div class="tab-content" id="tabChat"><div class="chat-area" id="chatArea"></div></div>
    <div class="tab-content" id="tabRules"><div class="info-text" id="rulesContent"></div></div>
    <div class="tab-content" id="tabHistory"><div class="info-text" id="historyContent"></div></div>
    <div class="tab-content" id="tabAIHow"><div class="info-text" id="aiHowContent"></div></div>
  </div>
</div>

<div class="status-bar">
  <span id="sessionIdShort">—</span>
  <span style="display:flex;gap:10px;align-items:center">
    <a href="#" onclick="showModal('policyModal');return false" style="color:var(--text3);font-size:9px" data-i18n="agreement">Соглашение</a>
    <span style="color:var(--text4);font-size:9px">© Studio Amateur — <b>Савва Поляков</b> | Licensed Software | studioameteurofficially@gmail.com</span>
  </span>
  <span id="gameTimeDisplay"></span>
</div>
<div class="modal-overlay" id="settingsModal">
<div class="modal" style="max-width:500px">
  <h2>&#9881; <span data-i18n="settings">Настройки</span></h2>
  <div class="settings-group">
    <h3 data-i18n="s_language">Язык / Language</h3>
    <div class="setting-row"><span data-i18n="s_lang_lbl">Язык интерфейса:</span>
      <select id="settingLang"><option value="ru">Русский</option><option value="en">English</option></select>
    </div>
  </div>
  <div class="settings-group">
    <h3 data-i18n="s_theme">Визуальный стиль</h3>
    <div class="theme-preview" id="themePreview">
      <div class="theme-card selected" data-theme="2000" onclick="selectThemeCard(this)">
        <div style="font-size:14px">📋</div><div>2000s</div>
      </div>
      <div class="theme-card" data-theme="cyber" onclick="selectThemeCard(this)">
        <div style="font-size:14px">🌃</div><div>Cyberpunk</div>
      </div>
      <div class="theme-card" data-theme="hacker" onclick="selectThemeCard(this)">
        <div style="font-size:14px">💻</div><div>Hacker</div>
      </div>
      <div class="theme-card" data-theme="modern" onclick="selectThemeCard(this)">
        <div style="font-size:14px">✨</div><div data-i18n="s_modern">Современный</div>
      </div>
    </div>
  </div>
  <div class="settings-group">
    <h3 data-i18n="s_music">Фоновая музыка</h3>
    <div class="setting-row"><span data-i18n="s_music_style">Стиль музыки:</span>
      <select id="settingMusicStyle"><option value="calm" data-i18n-opt="s_calm">Спокойная</option><option value="energetic" data-i18n-opt="s_energy">Энергичная</option></select>
    </div>
  </div>
  <div class="settings-group">
