function createGame(size,aiData,rules,komi,handicap,time,color){
var board=[];for(var i=0;i<size;i++){board[i]=[];for(var j=0;j<size;j++)board[i][j]=0;}
var pc=color==='black'?1:2;
var g={size:size,board:board,currentPlayer:1,playerColor:pc,aiColor:pc===1?2:1,
